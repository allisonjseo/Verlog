# Copy to monitor.env (same dir) and fill in. monitor.env is gitignored.
# All values are user/host-specific.

# --- Slack (used by slack_post.sh and gate.sh) ---
SLACK_CHANNEL_ID=C0AUT3L5R0V
SLACK_CHANNEL_NAME=unscripted-claude-mgmt
SLACK_TOKEN_FILE=$HOME/.slack_bot_token
ACK_TIMEOUT_SECONDS=600

# Identifies this monitor instance in Slack messages. One per host/allocation.
CLUSTER_ID=cpulling-access

# --- Slurm ---
USER_NAME=cpulling1

# --- Verlog run artifacts (logs, ckpts) — typically a scratch dir outside the repo ---
SMOKETEST_DIR=/u/cpulling1/verlog-smoketest

# Where the monitor writes its own logs. Defaults to $SMOKETEST_DIR/logs/monitor.
# MONITOR_LOG_DIR=

# --- wandb ---
WANDB_PROJECT=aseo-carnegie-mellon-university/verlog-gambit
WANDB_KEY_FILE=$HOME/.wandb_key

# --- Conda env used to run the wandb query inside the monitor prompt ---
CONDA_SH=/sw/rh9.4/python/miniforge3/etc/profile.d/conda.sh
CONDA_ENV_PATH=/u/cpulling1/.conda/envs/verlog

# --- Pacing ---
INTERVAL_SECONDS=10800       # 3 hours between iterations
CLAUDE_TIMEOUT_SECONDS=600   # 10 min cap per claude invocation
